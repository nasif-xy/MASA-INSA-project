# Copy to .env and replace paths/passwords with your local values.
# Keep .env private; never commit credentials.
MOBILE_PENTEST_POSTGRES_HOST=localhost
MOBILE_PENTEST_POSTGRES_PORT=5432
MOBILE_PENTEST_POSTGRES_DB=MASA_DB
MOBILE_PENTEST_POSTGRES_USER=postgres
MOBILE_PENTEST_POSTGRES_PASSWORD=change-me

# Local single-user demo default. Remove/comment this to use PostgreSQL.
MOBILE_PENTEST_DATABASE_URL=sqlite:///./storage/masa.sqlite3

MOBILE_PENTEST_JAVA_PATH=C:/Program Files/Java/jdk-21/bin/java.exe
MOBILE_PENTEST_APKTOOL_JAR_PATH=C:/tools/apktool.jar
MOBILE_PENTEST_JADX_JAR_PATH=C:/tools/jadx/lib/jadx-cli-all.jar

MOBILE_PENTEST_GHIDRA_ENABLED=false
MOBILE_PENTEST_GHIDRA_HEADLESS_PATH=C:/tools/ghidra/support/analyzeHeadless.bat
MOBILE_PENTEST_GHIDRA_TIMEOUT_SECONDS=900
MOBILE_PENTEST_GHIDRA_LIBRARY_TIMEOUT_SECONDS=300
MOBILE_PENTEST_GHIDRA_AUTO_EXTEND_TIMEOUT=true

# Replace your-user and confirm these locations in Android Studio.
MOBILE_PENTEST_ANDROID_SDK_PATH=C:/Users/your-user/AppData/Local/Android/Sdk
MOBILE_PENTEST_ADB_PATH=C:/Users/your-user/AppData/Local/Android/Sdk/platform-tools/adb.exe
MOBILE_PENTEST_EMULATOR_PATH=C:/Users/your-user/AppData/Local/Android/Sdk/emulator/emulator.exe
MOBILE_PENTEST_AVD_NAME=Dy-MASA
MOBILE_PENTEST_ANDROID_AVD_HOME=C:/Users/your-user/.android/avd
MOBILE_PENTEST_DYNAMIC_TIMEOUT_SECONDS=180
MOBILE_PENTEST_EMULATOR_BOOT_TIMEOUT_SECONDS=180
MOBILE_PENTEST_DYNAMIC_DEVICE_SERIAL=
MOBILE_PENTEST_DYNAMIC_ALLOW_PHYSICAL_DEVICE=false
MOBILE_PENTEST_DYNAMIC_SCAN_PERSONAL_STORAGE=false

MOBILE_PENTEST_TOOL_TIMEOUT_SECONDS=600
MOBILE_PENTEST_ENABLE_TERMINAL=false
MOBILE_PENTEST_TERMINAL_TOKEN=
MOBILE_PENTEST_MAX_UPLOAD_BYTES=314572800
MOBILE_PENTEST_MAX_CONCURRENT_ANALYSIS_JOBS=1
